# Supabase project settings for GET TO IT.
# Copy this file to .env.local and fill in your own project values.
# The anon key is browser-safe: row level security enforces who can read what.
# The service-role key below is server-only and is used only for sanitized
# unhandled-server-error monitoring. Never expose it to the browser or commit it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Ollama cloud API key (https://ollama.com/settings/keys).
# Server-side only: it powers the "I'M STUCK" suggestions and is never
# exposed to the browser.
OLLAMA_API_KEY=

# Stripe test-mode keys for prepaid AI credits. Server-side only, never
# NEXT_PUBLIC_. Use test keys (sk_test_...) until you deliberately go live, and
# point the webhook endpoint at /api/stripe/webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Taking real money is a separate decision. A live key (sk_live_...) is ignored
# unless this is exactly "true"; leave it unset while testing.
STRIPE_ALLOW_LIVE=

# Phase 22 preview runner. Server-side only. The runner is a separate process
# on a Linux host that supports unprivileged user namespaces; the app never runs
# project code itself. Set the same token and signing secret on both sides.
PREVIEW_RUNNER_URL=http://127.0.0.1:4311
PREVIEW_RUNNER_TOKEN=
PREVIEW_SIGNING_SECRET=
PREVIEW_PUBLIC_ORIGIN=http://preview.localhost:4310

# Phase 24 deployment vault. Server-side only. Generate exactly 32 random bytes
# and encode them as base64 (or use 64 hex characters). Provider tokens and
# environment values are encrypted with AES-256-GCM before storage. Without it,
# connections and deployment plans cannot be saved; there is no fallback key.
DEPLOYMENT_VAULT_KEY=

# Composio connections (Phase 31). Server-side only. Create a project at
# https://platform.composio.dev, copy its API key, and set APP_ORIGIN to the
# exact public origin users open. The OAuth callback is
# {APP_ORIGIN}/api/composio/callback and must be allowed by that Composio
# project. Never expose COMPOSIO_API_KEY to the browser or generated projects.
COMPOSIO_API_KEY=
APP_ORIGIN=

# Phase 26 Supabase OAuth app. Server-side only. Create this OAuth app under
# the Supabase organization's Settings -> OAuth Apps (Management API), then
# register the exact callback URL below. Do not use the project's
# Authentication -> OAuth Apps page, which is only a "Sign in with Supabase"
# identity provider and cannot manage organizations or projects. The client
# secret is never sent to the browser.
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=
SUPABASE_OAUTH_REDIRECT_URI=https://your-app.example.com/api/integrations/supabase/callback

# E2E runner only. This key is not read by the app or by the runner from this
# file; pass it in the process environment for `npm run test:e2e`. Use a
# dedicated test project; never commit it or expose it to the browser.
# E2E_SERVICE_ROLE_KEY=

# Capability token for the payment webhook, which has no signed-in user.
# Generate a long random value, put it here and store the same value in
# public.app_secrets under the name 'credit_webhook' (SQL editor). Without both
# halves the webhook refuses to run and no credits are granted.
CREDIT_RPC_TOKEN=

# Real-time Resend delivery webhook. Server-side only. Create the webhook at
# https://resend.com/webhooks or with the Resend API; point it at
# {APP_ORIGIN}/api/webhooks/resend and subscribe to bounced, complained, failed,
# suppressed and delivery_delayed events. RESEND_WEBHOOK_SECRET is the
# `whsec_...` signing secret returned once by Resend. GITHUB_ALERT_TOKEN is a
# GitHub token with issues:write for the alert repository; GITHUB_ALERT_REPO is
# OWNER/REPO. The webhook never logs or stores recipient addresses or message
# bodies.
RESEND_WEBHOOK_SECRET=
GITHUB_ALERT_TOKEN=
GITHUB_ALERT_REPO=
