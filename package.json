  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:restore": "node scripts/restore-check.mjs",
    "test:e2e": "node scripts/e2e-http.mjs",
    "test:functional": "node scripts/e2e-functional.mjs",
    "test:seats": "node scripts/e2e-team-seats.mjs",
    "test:e2e:cleanup": "node scripts/e2e-cleanup-accounts.mjs",
    "test:email": "node scripts/email-signup-smoke.mjs",
    "test:preview": "PREVIEW_RUNNER_TEST=1 vitest run tests/preview-runner.integration.test.ts",
    "check:e2e:post-merge": "node scripts/post-merge-e2e-check.mjs",
    "check:secrets": "node scripts/secrets-check.mjs",
    "check:vercel-aliases": "node --env-file-if-exists=.env.local scripts/vercel-alias-inventory.mjs",
    "release:check": "node scripts/release-check.mjs"
  },
  "dependencies": {
    "@composio/core": "0.28.0",
    "@renderinc/sdk": "1.8.0",
    "@supabase/ssr": "0.12.7",
